# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real credentials.

# --- Notifications (ntfy.sh push to your phone) ---
# Pick a unique, hard-to-guess topic name (it's a public-by-default pub/sub
# topic). Install the ntfy app on your phone and subscribe to this same
# topic to get a push notification on every entry/exit.
NTFY_TOPIC=gold-bot-change-me-to-something-random
NTFY_SERVER=https://ntfy.sh

# --- Optional: Telegram instead of / in addition to ntfy ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- MetaTrader 5 (only needed once you switch BROKER=mt5 for live trading) ---
# MT5 only works when this process runs on the same Windows machine/VPS as
# a logged-in MT5 terminal. Not usable from this cloud container.
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
# MT5_SYMBOL=XAUUSD

# --- Which broker backend to use: paper | mt5 ---
BROKER=paper

# --- Paper broker starting balance (USD) ---
PAPER_STARTING_BALANCE=10000
